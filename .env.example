# Copy to .env and fill in (never commit .env).
#   cp .env.example .env

# --- required: one of these ---
# mDNS name from the Sonos app / dns-sd (stable across DHCP):
SONOS_HOST=Sonos-AABBCCDDEEFF.local

# Or a dotted IPv4 (overrides SONOS_HOST when both are set):
# SONOS_IP=192.168.1.50

# --- optional ---
# SONOS_VOL=45
# SONOS_HTTP_PORT=8765
# SONOS_BIND_IP=192.168.1.10
# SONOS_QUARTER_SEC=0.50
